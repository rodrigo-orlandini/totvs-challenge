    {
      "id": "clean_architecture_pattern",
      "label": "Clean Architecture Pattern",
      "file_type": "rationale",
      "source_file": "C:\\Users\\rodri\\projects\\totvs\\docs\\superpowers\\specs\\2026-09-19-modular-monolith-clean-architecture-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Monolito modular estruturado para migração futura a microsserviços sem retrabalho; cada módulo encapsula entities, use-cases, repositories, infra, mappers, presenters com regra de dependência inviolável"
    },
    {
      "id": "transactional_outbox_pattern",
      "label": "Transactional Outbox Pattern",
      "file_type": "rationale",
      "source_file": "C:\\Users\\rodri\\projects\\totvs\\docs\\superpowers\\specs\\2026-09-20-erp-sync-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Garante que a detecção do ERP e o enfileiramento na fila sejam atômicos; se o processo cair antes do COMMIT o cursor não avança e o próximo ciclo redetecta — sem mensagens fantasma"
    },
    {
      "id": "either_pattern",
      "label": "Either<DomainError, T> Error Handling Pattern",
      "file_type": "rationale",
      "source_file": "C:\\Users\\rodri\\projects\\totvs\\src\\shared\\core\\architecture-rules.md",
      "source_location": "15-18",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Todo use-case retorna Either<DomainError, T> — nenhuma exceção não tratada chega ao cliente; controllers fazem match no Either e delegam ao presenter (right) ou ao http-error-mapper (left)"
    },
    {
      "id": "bullmq_technology",
      "label": "BullMQ Queue Technology",
      "file_type": "concept",
      "source_file": "C:\\Users\\rodri\\projects\\totvs\\docs\\superpowers\\specs\\2026-09-20-erp-sync-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Escolhido sobre NATS porque usa Redis já presente no stack, tem suporte nativo a retry com backoff exponencial, DLQ (failed queue), deduplication por jobId e Bull Board para monitoramento — sem código extra"
    },
    {
      "id": "cursor_based_polling",
      "label": "Cursor-Based ERP Polling Strategy",
      "file_type": "rationale",
      "source_file": "C:\\Users\\rodri\\projects\\totvs\\docs\\superpowers\\specs\\2026-09-20-erp-sync-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "WHERE updatedAt > lastSyncedAt traz apenas delta — poll full a cada 5s em tabela grande seria custoso; cursor armazenado em sync_cursors persiste entre restarts"
    },
    {
      "id": "tdd_red_green_refactor",
      "label": "TDD Red-Green-Refactor Cycle",
      "file_type": "rationale",
      "source_file": "C:\\Users\\rodri\\projects\\totvs\\.claude\\skills\\tdd\\SKILL.md",
      "source_location": "18-26",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Tests verify behavior through public interfaces and must survive refactors; forbidden patterns: implementation-coupled tests, tautological assertions, horizontal slicing"
    },
