{
  "name": "casecellshop",
  "version": "1.0.0",
  "description": "CaseCellShop backend — vitrine virtual e checkout assíncrono",
  "main": "dist/main.js",
  "scripts": {
    "dev": "docker compose up",
    "build": "tsc --noEmit && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "docker compose -f docker-compose.test.yml up -d && vitest run --config vitest.integration.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:migrate:test": "DATABASE_URL=$TEST_DATABASE_URL prisma migrate deploy",
    "db:migrate:erp": "DATABASE_URL=$ERP_DATABASE_URL prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.mjs",
    "db:seed:erp": "ERP_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/casecellshop_erp node prisma/seed.mjs --target erp",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.1",
    "@bull-board/fastify": "^9.10.1",
    "@fastify/swagger": "^8.0.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^5.0.0",
    "bullmq": "^6.3.8",
    "fastify": "^4.0.0",
    "ioredis": "^5.0.0",
    "pino": "^9.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.0",
    "tsyringe": "^4.8.0",
    "uuid": "^9.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^8.0.0",
    "prisma": "^5.0.0",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
